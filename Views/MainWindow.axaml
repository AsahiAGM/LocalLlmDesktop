
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LocalLlmDesktop.ViewModels"
        xmlns:models="using:LocalLlmDesktop.Models"
        xmlns:converters="using:LocalLlmDesktop.Views.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="LocalLlmDesktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="LocalLlmDesktop">

        <Window.Resources>
                <converters:RoleToAlignmentConverter x:Key="RoleToAlignmentConverter" />
                <converters:RoleToBrushConverter x:Key="RoleToBrushConverter" />
        </Window.Resources>

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Width="600">

        <TextBox x:Name="InputTextBox"
                 Text="{Binding InputText, Mode=TwoWay}"
                 PlaceholderText="メッセージを入力してください" 
                 AcceptsReturn="True"/>

        <Button Content="送信"
                Command="{Binding SendMessageCommand}"
                HorizontalAlignment="Left" />

        <TextBlock Text="{Binding StatusText}" />

        <ScrollViewer Height="280">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <Grid>
                            <Border HorizontalAlignment="{Binding Role, Converter={StaticResource RoleToAlignmentConverter}}"
                                    MaxWidth="400"
                                    Background="{Binding Role, Converter={StaticResource RoleToBrushConverter}}"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="4">
                                 <TextBlock Text="{Binding Content}"
                                            TextWrapping="Wrap"
                                            Foreground="white"/>                              
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
             </ItemsControl>
        </ScrollViewer>

    </StackPanel>

</Window>
